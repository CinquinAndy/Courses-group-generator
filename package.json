{
	"name": "courses-group-generator",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"format": "biome format --write .",
		"precommit": "lint-staged",
		"prepare": "husky"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched",
			"git add"
		]
	},
	"dependencies": {
		"aos": "2.3.4",
		"daisyui": "5.5.19",
		"next": "16.2.6",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"zustand": "5.0.13"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@tailwindcss/postcss": "4.3.0",
		"@types/aos": "3.0.8",
		"@types/node": "25.9.0",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"autoprefixer": "10.5.0",
		"husky": "9.1.7",
		"lint-staged": "17.0.5",
		"postcss": "8.5.14",
		"tailwindcss": "4.3.0",
		"typescript": "6.0.3"
	}
}
